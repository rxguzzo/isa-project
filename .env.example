# Banco PostgreSQL (o docker-compose.yml sobe um local com estes dados)
DATABASE_URL="postgresql://isa_admin:isa_secret_password@localhost:5432/isa_db?schema=public"

# Segredo para assinar os tokens JWT (gere um valor longo e aleatório)
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Usuário administrador criado pelo seed (npx prisma db seed)
ADMIN_EMAIL="admin@isa.com"
ADMIN_PASSWORD="troque-por-uma-senha-com-12+-caracteres"
